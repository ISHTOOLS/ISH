NODE_ENV=production
PORT=4000
STRICT_MODE=true
DISABLE_FALLBACKS=true
REQUIRE_MTLS=false
TRUST_PROXY=false
BODY_LIMIT=256kb
AUDIT_MAX_BYTES=10485760
SESSION_TTL_MS=28800000
ADMIN_TOKEN=REPLACE_WITH_RANDOM_SECRET
# MTLS_PORT=4443
# CLUSTER_NODE_ID=node-1
# CLUSTER_PEERS=https://node-2:4000,https://node-3:4000
# CLUSTER_SECRET=REPLACE_WITH_RANDOM_SECRET
# ISHLOCK_API_KEYS={"REPLACE_WITH_RANDOM_API_KEY":"tenant-id"}
# HSM_PIN=REPLACE_WITH_SECRET_MANAGER_VALUE

# Threat Intelligence Fabric
THREAT_INTEL_ENABLED=true
# Required for sensor-to-collector ingestion; fail-closed when absent
THREAT_INTEL_INGEST_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
THREAT_INTEL_MAX_EVENTS=50000
THREAT_INTEL_MAX_PROFILES=20000
THREAT_INTEL_REQUIRE_MTLS_INGEST=true
