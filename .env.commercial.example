# Commercial payment configuration
# NEVER commit real IBANs or private keys to Git.
ISH_PAYMENT_ACCOUNT_NAME=YOUR_ACCOUNT_HOLDER_NAME
ISH_PAYMENT_IBAN_TRY=YOUR_TRY_IBAN
ISH_PAYMENT_IBAN_EUR=YOUR_EUR_IBAN
ISH_PAYMENT_IBAN_USD=YOUR_USD_IBAN

# Optional: override the built-in commercial catalog with a JSON array.
# ISH_PLANS_JSON=[{"id":"professional-try","name":"Professional","amount":5990,"durationDays":365,"currency":"TRY"}]

# License authority secrets must remain outside source control.
# ISH_LICENSE_PRIVATE_KEY=...
# ISH_LICENSE_PUBLIC_KEY=...
